# ── Database ─────────────────────────────────────────────────────────────────
# Postgres connection string. The only setting the app truly depends on.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/grailwatch

# ── Server ───────────────────────────────────────────────────────────────────
# Port for the Express API. The web dev server proxies /api/* here.
API_PORT=4000
# Public URL of the web app; used to build links in Discord alerts.
WEB_BASE_URL=http://localhost:5173

# ── Jobs / scheduling ────────────────────────────────────────────────────────
# Master switch for node-cron scheduling inside the API process.
ENABLE_CRON=true
# Cron expressions (server local time).
CRON_INGEST=0 2 * * *
CRON_SCORE=45 2 * * *
CRON_DELIVER=0 3 * * *
# On API boot, if snapshots exist but the latest data date has no scores yet,
# run score + deliver once automatically. This is what makes the zero-key demo
# show a triggered alert right after `pnpm run seed && pnpm run dev`.
ENABLE_BOOTSTRAP_SCORE=true

# ── Market data sources (ALL optional — a missing key means the adapter logs
#    a warning and is skipped; the nightly run never crashes) ─────────────────
# PriceCharting paid API token (sold comps + volume — the backbone source).
# https://www.pricecharting.com/api-documentation
PRICECHARTING_API_KEY=
# eBay developer keys. The Browse API client-credentials flow needs BOTH the
# App ID (client id) and Cert ID (client secret): https://developer.ebay.com/my/keys
EBAY_APP_ID=
EBAY_CERT_ID=
# 'production' or 'sandbox'
EBAY_ENV=production

# Directory containing market.csv / pop.csv / attention.csv for the nightly
# CSV market source — lets the whole pipeline run with zero API keys beyond
# the one-time seed. Example: packages/db/seed-data
CSV_SOURCE_DIR=

# ── Attention sources ────────────────────────────────────────────────────────
# Google Trends needs no key (unofficial endpoint; degrades gracefully when
# rate-limited). Set to false to skip entirely.
ENABLE_GOOGLE_TRENDS=true
# Optional geo filter, e.g. US. Empty = worldwide.
GOOGLE_TRENDS_GEO=

# ── Pop report scrapers (PSA / CGC) ──────────────────────────────────────────
# Only cards with psa_pop_url / cgc_pop_url set are scraped (1 req / 2s, cached).
# Contact string appended to the scraper User-Agent — be a good citizen.
SCRAPER_CONTACT=
# Directory for the scraper HTTP cache (relative to where the job runs).
CACHE_DIR=.cache

# ── Alert delivery ───────────────────────────────────────────────────────────
# Discord incoming-webhook URL. Empty = Discord delivery skipped (email is a
# console stub for now, so alerts always at least print).
DISCORD_WEBHOOK_URL=

# ── Misc ─────────────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info

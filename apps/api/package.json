    "drizzle-orm": "^0.44.4",
    "express": "^5.1.0",
    "node-cron": "^3.0.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.2.1",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
